# ── Secrets and runtime data: never commit ───────────────────────────────
# Everything the running app writes: uploaded PDFs, job folders, edit history, app.log,
# the editable prompt files, and secret.key (the cookie-signing key made by ocr/auth.py).
data/
secret.key
.env
.env.*
*.pem
*.key

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# ── Notebook runs outside the app ────────────────────────────────────────
# The notebook writes ./compare_out/ next to where it is run; pdf/ is the notebook's default input folder.
compare_out/
pdf/
.ipynb_checkpoints/

# ── Web screen (web_src) ─────────────────────────────────────────────────
# web/dist/ is deliberately NOT ignored: it is the built screen the server serves, so the server needs no Node.
# Rebuild it with `npm run build` in web_src whenever web_src/src changes.
web_src/node_modules/
web_src/tests/roundtrip.out.json
*.tsbuildinfo

# ── Packaging, editors, operating systems ────────────────────────────────
*.zip
.vscode/
.idea/
.DS_Store
Thumbs.db
